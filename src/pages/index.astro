---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { posts } from '../data/posts';
import { openSource, starCounts } from '../data/openSource';
import PostCard from '../components/PostCard.astro';

const base = import.meta.env.BASE_URL;
const stars = await starCounts();
const siteUrl = new URL(base, Astro.site).href;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}#organization`,
      name: 'RUNTIME Robotics',
      url: siteUrl,
      logo: new URL(`${base}images/runtime_robotics_logo.webp`, Astro.site).href,
      description: 'Robot software engineering for ROS 2 and Physical AI: digital twins, simulation, perception, robot learning, humanoids, quadrupeds, AMRs and robotics training.',
      email: 'runtimerobotics@gmail.com',
      telephone: '+918907590702',
      address: { '@type': 'PostalAddress', addressLocality: 'Kochi', addressRegion: 'Kerala', addressCountry: 'IN' },
      founder: [
        { '@type': 'Person', name: 'Lentin Joseph', jobTitle: 'Co-founder and CEO', sameAs: 'https://www.linkedin.com/in/lentinjoseph/' },
        { '@type': 'Person', name: 'Aleena Johny', jobTitle: 'Co-founder', sameAs: 'https://www.linkedin.com/in/aleena-johny-83a3161a5/' }
      ],
      sameAs: ['https://www.linkedin.com/company/runtimerobotics/', 'https://github.com/runtimerobotics']
    },
    {
      '@type': 'Book',
      name: 'Mastering ROS 2 for Robotics Programming',
      bookEdition: 'Fourth Edition',
      author: [{ '@type': 'Person', name: 'Lentin Joseph' }, { '@type': 'Person', name: 'Jonathan Cacace' }],
      publisher: { '@type': 'Organization', name: 'Packt' },
      image: new URL(`${base}images/books/mastering-ros2-4th-edition.webp`, Astro.site).href,
      sameAs: 'https://www.amazon.com/stores/author/B07JX5VX17/allbooks'
    },
    { '@type': 'WebSite', '@id': `${siteUrl}#website`, name: 'RUNTIME Robotics', url: siteUrl, publisher: { '@id': `${siteUrl}#organization` } }
  ]
};

const serviceGroups = ['Robot engineering', 'Physical AI and simulation', 'Training'];

const services = [
  {
    title: 'Autonomous Navigation Systems',
    group: 'Robot engineering',
    image: 'revised/ros-navigation.webp',
    text: 'ROS 2 navigation, mapping, localization, planning, controls and sensor integration for autonomous mobile robots.',
    href: 'ros2-robotics-consulting/'
  },
  {
    title: 'Robot Manipulation & Motion Planning',
    group: 'Robot engineering',
    image: 'revised/robot-manipulation.webp',
    text: 'Pick-and-place, bin picking, grasping, motion planning and force-aware manipulation for industrial robot arms.',
    href: 'robot-manipulation-motion-planning/'
  },
  {
    title: 'Robot Perception & Edge AI',
    group: 'Robot engineering',
    image: 'revised/ros-perception.webp',
    text: '2D and 3D vision, LiDAR, depth cameras, detection, tracking and GPU-accelerated ROS 2 perception pipelines.',
    href: 'robot-perception-edge-ai/'
  },
  {
    title: 'ROS 2 Hardware & Driver Development',
    group: 'Robot engineering',
    image: 'revised/ros-driver-development.webp',
    text: 'Custom interfaces and drivers for cameras, LiDARs, motor controllers, embedded systems and complete robot platforms.',
    href: 'ros2-robotics-consulting/'
  },
  {
    title: 'Robot Simulation & Digital Twins',
    group: 'Physical AI and simulation',
    image: 'revised/robot-simulation.webp',
    text: 'OpenUSD digital twins, NVIDIA Omniverse, Isaac Sim, software-in-the-loop testing and synthetic data workflows.',
    href: 'nvidia-isaac-omniverse-development/'
  },
  {
    title: 'Humanoid Application Development',
    group: 'Physical AI and simulation',
    image: 'services/humanoid-unitree-robotics.webp',
    text: 'ROS 2 applications for humanoids: navigation, perception, manipulation, teleoperation and sim-to-real validation.',
    href: 'humanoid-robot-development/'
  },
  {
    title: 'Quadruped Robot Application Development',
    group: 'Physical AI and simulation',
    image: 'revised/quadruped-robotics.webp',
    text: 'Autonomous inspection, terrain-aware navigation, perception, payload integration and remote operator workflows.',
    href: 'quadruped-robot-development/'
  },
  {
    title: 'Robot Learning: RL, IL & Sim-to-Real',
    group: 'Physical AI and simulation',
    image: 'services/nvidia-robotics-stack.webp',
    text: 'Reinforcement learning, imitation learning, demonstration data, policy evaluation and controlled deployment workflows.',
    href: 'robot-learning-sim-to-real/'
  },
  {
    title: 'VLA, VLM & Multimodal Robot Applications',
    group: 'Physical AI and simulation',
    image: 'revised/vla-vlm-robotics.webp',
    text: 'Vision-language models and vision-language-action prototypes for scene understanding, task planning and robot interaction.',
    href: 'vla-vlm-robotics/'
  },
  {
    title: 'Synthetic Data & Physical AI Pipelines',
    group: 'Physical AI and simulation',
    image: 'services/nvidia-omniverse-digital-twin.webp',
    text: 'RTX sensor simulation, domain randomization, synthetic datasets, teleoperation data and Physical AI evaluation pipelines.',
    href: 'physical-ai-development/'
  },
  {
    title: 'Industrial ROS & ROS 2 Training',
    group: 'Training',
    image: 'revised/industrial-ros-training.webp',
    text: 'Hands-on training in navigation, manipulation, perception, drivers, Docker, simulation and deployment.',
    href: 'robotics-training/'
  },
  {
    title: 'NVIDIA Omniverse & Isaac Training',
    group: 'Training',
    image: 'revised/nvidia-robotics-training.webp',
    text: 'OpenUSD, Omniverse, Isaac Sim, Isaac ROS, Isaac Lab, digital twins, synthetic data and robot learning workshops.',
    href: 'robotics-training/'
  }
];

const categoryLabels: Record<string, string> = { humanoid: 'Humanoid', 'learning-ai': 'Learning + AI', navigation: 'Navigation', manipulation: 'Manipulation', simulation: 'Simulation' };

const projects = [
  {
    title: 'Unitree G1 & R1 Humanoid Navigation',
    category: 'humanoid',
    image: 'services/humanoid-unitree-robotics.webp',
    text: 'Localization, navigation, obstacle awareness, safety boundaries and mission-level task control for humanoid platforms.',
    href: 'unitree-g1-r1-development/'
  },
  {
    title: 'Humanoid Perception & Manipulation',
    category: 'humanoid',
    image: 'services/nvidia-robotics-stack.webp',
    text: '3D scene understanding, grasp planning and task execution with humanoid arms and dexterous end effectors.'
  },
  {
    title: 'RL Locomotion & Whole-Body Control',
    category: 'learning-ai',
    image: 'revised/rl-locomotion-whole-body-control.webp',
    text: 'Simulation environments, reward design, policy training, evaluation and controlled sim-to-real transfer for humanoids.'
  },
  {
    title: 'Imitation Learning & Teleoperation',
    category: 'learning-ai',
    image: 'revised/nvidia-robotics-training.webp',
    text: 'Demonstration collection, dataset processing, policy training and deployment validation for embodied robot tasks.'
  },
  {
    title: 'VLA/VLM Physical AI Task Execution',
    category: 'learning-ai',
    image: 'revised/vla-vlm-robotics.webp',
    text: 'Natural-language task interfaces, visual grounding, semantic scene understanding and controlled action pipelines.'
  },
  {
    title: 'Quadruped Autonomous Inspection',
    category: 'navigation',
    image: 'revised/quadruped-robotics.webp',
    text: 'Perception-led patrols, mapping, waypoint navigation and remote operator workflows for quadruped robots.'
  },
  {
    title: 'AMR Digital Twin & Fleet Validation',
    category: 'simulation',
    image: 'revised/robot-simulation.webp',
    text: 'Warehouse simulation, sensor modelling, navigation stress testing and synthetic data generation for AMR systems.'
  },
  {
    title: 'Industrial Manipulation Cell',
    category: 'manipulation',
    image: 'revised/industrial-robot-arm.webp',
    text: 'Vision-guided pick-and-place, motion planning, gripper integration and workstation safety logic.'
  }
];

// Monogram for the name tiles: first letters of the first two words.
const initials = (name: string) => name.split(' ').slice(0, 2).map((w) => w[0]).join('');

const clients = [
  'ISRO', 'Apress', 'Duplex', 'Bedestrian', 'Remy Robotics', 'Robomania', 'Swift',
  'CircleX', 'StreetDrone', 'Viscon', 'Wipro', 'Tata Motors', 'TCS',
  'Spotless', 'IBM', 'GM', 'ArkRobot', 'Packt'
];
---
<BaseLayout structuredData={structuredData}>
  <Header />

  <main id="main">
    <section class="hero" id="home">
      <div class="hero-grid-bg" aria-hidden="true"></div>
      <div class="container hero-grid">
        <div class="hero-copy">
          <div class="eyebrow"><span></span> Robot software engineering</div>
          <h1>Powering Physical AI robots from <em>simulation to deployment</em></h1>
          <p>Engineering support for ROS 2, NVIDIA Omniverse and Physical AI—from digital twins, perception and robot learning to humanoids, quadrupeds, AMRs and industrial deployment.</p>
          <div class="hero-actions">
            <a class="button" href="#services">Explore services</a>
            <a class="button button-ghost" href="#contact">Discuss a project</a>
          </div>
          <div class="hero-points" aria-label="Capabilities">
            <span>Humanoid · Quadruped · AMR</span>
            <span>Physical AI</span>
            <span>Simulation to deployment</span>
          </div>
        </div>

        <div class="hero-visual" aria-label="Humanoid, quadruped and autonomous mobile robot warehouse application">
          <div class="orb orb-one"></div>
          <div class="orb orb-two"></div>
          <div class="robot-card">
            <img fetchpriority="high" src={`${base}images/revised/physical-ai-warehouse-hero-v2.webp`} alt="Humanoid, quadruped and autonomous mobile robots working together in a warehouse" width="768" height="432" />
            <div class="robot-status"><span></span> Physical AI systems online</div>
          </div>
          <div class="floating-card card-top">
            <strong>Embodied robotics</strong>
            <span>Humanoid · Quadruped · AMR</span>
          </div>
          <div class="floating-card card-bottom">
            <strong>Learning + simulation</strong>
            <span>Isaac Sim · RL · IL</span>
          </div>
        </div>
      </div>
    </section>

    <section class="stats-strip" aria-label="RUNTIME Robotics in numbers">
      <div class="container stats-grid">
        <div><strong>2010</strong><span>building and teaching ROS since</span></div>
        <a href="#books"><strong>11</strong><span>books on ROS and robotics</span></a>
        <div><strong>{clients.length}+</strong><span>organizations worked with</span></div>
        <div><strong>ROS 2 + Isaac</strong><span>from simulation to deployment</span></div>
      </div>
    </section>

    <section class="section clients-section" id="clients">
      <div class="container">
        <div class="section-heading reveal">
          <div><span class="kicker">Experience</span><h2>Organizations we have worked with</h2></div>
          <p>Companies, research teams and publishers we have built robot software, training and books with.</p>
        </div>
        <div class="client-marquee reveal">
          <div class="client-track">
            <div class="client-cloud">{clients.map((client) => <span><b aria-hidden="true">{initials(client)}</b>{client}</span>)}</div>
            <div class="client-cloud" aria-hidden="true">{clients.map((client) => <span><b aria-hidden="true">{initials(client)}</b>{client}</span>)}</div>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="services">
      <div class="container">
        <div class="section-heading reveal">
          <div><span class="kicker">Capabilities</span><h2>Our services</h2></div>
          <p>From ROS 2 engineering to Physical AI, we help teams build, train, validate and deploy modern robot systems.</p>
        </div>
        {serviceGroups.map((group) => (
          <>
          <h3 class="service-group-title reveal">{group}</h3>
          <div class="card-grid service-grid">
          {services.filter((service) => service.group === group).map((service, i) => (
            <article class="service-card reveal" style={`--delay:${i * 60}ms`}>
              <div class="service-image"><img src={`${base}images/${service.image}`} alt={service.title} loading="lazy" /></div>
              <div class="service-content">
                <span class="service-index">{String(services.indexOf(service) + 1).padStart(2, '0')}</span>
                <h3>{service.title}</h3>
                <p>{service.text}</p>
                {service.href && <a class="service-link" href={`${base}${service.href}`}>Explore this service →</a>}
              </div>
            </article>
          ))}
          </div>
          </>
        ))}
      </div>
    </section>

    <section class="section section-dark" id="projects">
      <div class="container">
        <div class="section-heading reveal">
          <div><span class="kicker">Capabilities in action</span><h2>Featured solution tracks</h2></div>
          <p>Solution areas spanning humanoids, robot learning, navigation, manipulation and simulation.</p>
        </div>

        <div class="filter-bar reveal" role="group" aria-label="Filter projects">
          <button class="filter-button active" data-filter="all">All</button>
          <button class="filter-button" data-filter="humanoid">Humanoid</button>
          <button class="filter-button" data-filter="learning-ai">Learning + AI</button>
          <button class="filter-button" data-filter="navigation">Navigation</button>
          <button class="filter-button" data-filter="manipulation">Manipulation</button>
          <button class="filter-button" data-filter="simulation">Simulation</button>
        </div>

        <div class="project-grid">
          {projects.map((project, index) => (
            <article class="project-card reveal" style={`--delay:${index * 60}ms`} data-project data-category={project.category}>
              <div class="project-image">
                <img src={`${base}images/${project.image}`} alt={project.title} loading="lazy" />
              </div>
              <div class="project-content">
                <span>{categoryLabels[project.category]}</span>
                <h3>{project.title}</h3>
                <p>{project.text}</p>
                {project.href && <a class="service-link" href={`${base}${project.href}`}>Explore this service →</a>}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>


    <section class="section" id="open-source">
      <div class="container">
        <div class="section-heading reveal">
          <div><span class="kicker">Open source</span><h2>Tools and workshops we share</h2></div>
          <p>Our public code: ROS 2 tooling used by the community, and the material behind our Physical AI workshops.</p>
        </div>
        <div class="oss-grid">
          {openSource.map((item, i) => (
            <a class="oss-card reveal" style={`--delay:${i * 50}ms`} href={`https://github.com/runtimerobotics/${item.repo}`} target="_blank" rel="noreferrer">
              <span class="oss-kind">{item.kind}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
              <span class="oss-meta">{stars[item.repo] > 0 && <span>★ {stars[item.repo]}</span>} View on GitHub ↗</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section section-dark" id="books">
      <div class="container book-feature">
        <a class="book-cover reveal" href="https://www.amazon.com/stores/author/B07JX5VX17/allbooks" target="_blank" rel="noreferrer">
          <img src={`${base}images/books/mastering-ros2-4th-edition.webp`} alt="Mastering ROS 2 for Robotics Programming, Fourth Edition, by Lentin Joseph and Jonathan Cacace (Packt)" loading="lazy" />
        </a>
        <div class="book-copy reveal">
          <span class="kicker">Books by our team</span>
          <h2>11 books on ROS and robotics, written by our co-founder</h2>
          <span class="book-badge">Latest · Fourth Edition</span>
          <h3>Mastering ROS 2 for Robotics Programming</h3>
          <p>Design, build, simulate and prototype complex robots using the Robot Operating System 2.</p>
          <p class="book-meta">By Lentin Joseph and Jonathan Cacace · Packt</p>
          <p>The book features our open-source <a href="https://github.com/runtimerobotics/fusion360-urdf-ros2" target="_blank" rel="noreferrer">Fusion 360 → URDF exporter for ROS 2</a>.</p>
          <a class="button" href="https://www.amazon.com/stores/author/B07JX5VX17/allbooks" target="_blank" rel="noreferrer">See all books on Amazon ↗</a>
        </div>
      </div>
    </section>

    <section class="section section-soft" id="about">
      <div class="container">
        <div class="section-heading reveal">
          <div><span class="kicker">Who we are</span><h2>Engineering robots from software outward</h2></div>
          <p>RUNTIME Robotics works with commercial and research teams on robot software, simulation, algorithms, perception and integration, helping turn robotics ideas into reliable systems while sharing practical knowledge through training.</p>
        </div>
        <div class="team-grid">
          <article class="team-card reveal">
            <img src={`${base}images/lentin.webp`} alt="Lentin Joseph" loading="lazy" />
            <div>
              <span>Co-Founder · ROS Developer & Educator</span>
              <h3>Lentin Joseph</h3>
              <p>ROS developer and educator since 2010, author of 11 books on ROS, and a hands-on engineering partner for simulation, navigation and robot-software projects.</p>
              <a class="team-link" href="https://www.linkedin.com/in/lentinjoseph/" target="_blank" rel="noreferrer">View LinkedIn profile <span aria-hidden="true">↗</span></a>
            </div>
          </article>
          <article class="team-card reveal">
            <img src={`${base}images/aleena.webp`} alt="Aleena Johny" loading="lazy" />
            <div>
              <span>Co-Founder · ROS Developer & Educator</span>
              <h3>Aleena Johny</h3>
              <p>ROS software developer, educator and co-author supporting practical robot-software delivery, training and modern ROS 2 development workflows.</p>
              <a class="team-link" href="https://www.linkedin.com/in/aleena-johny-83a3161a5/" target="_blank" rel="noreferrer">View LinkedIn profile <span aria-hidden="true">↗</span></a>
            </div>
          </article>
        </div>
        <div class="feature-list about-points reveal">
          <div><strong>Research + commercial</strong><span>Support from prototypes through product integration.</span></div>
          <div><strong>Remote friendly</strong><span>Development workflows designed for distributed robot teams.</span></div>
          <div><strong>Education</strong><span>Hands-on ROS learning for engineers and students.</span></div>
        </div>
      </div>
    </section>


    <section class="section blog-preview section-soft" id="blog">
      <div class="container">
        <div class="section-heading reveal">
          <div><span class="kicker">Knowledge</span><h2>From the blog</h2></div>
          <a class="text-link" href={`${base}blog/`}>View all articles →</a>
        </div>
        {posts.slice(0, 3).map((post) => <PostCard post={post} reveal />)}
      </div>
    </section>

    <section class="section contact-section" id="contact">
      <div class="container contact-grid">
        <div class="contact-copy reveal">
          <span class="kicker">Get in touch</span>
          <h2>Need help with a robotics project?</h2>
          <p>Tell us what robot, software stack and development challenge you are working on.</p>
          <div class="contact-links">
            <a href="mailto:runtimerobotics@gmail.com"><span>Email</span><strong>runtimerobotics@gmail.com</strong></a>
            <a href="tel:+918907590702"><span>Phone</span><strong>+91 8907590702</strong></a>
            <a href="https://wa.me/918907590702" target="_blank" rel="noreferrer"><span>WhatsApp</span><strong>Chat on WhatsApp ↗</strong></a>
            <div><span>Location</span><strong>Kochi, Kerala, India</strong></div>
          </div>
        </div>

        <form class="contact-form reveal" data-contact-form data-endpoint="https://formspree.io/f/xkjwepkp">
          <div class="form-row">
            <label>First name<input name="firstName" autocomplete="given-name" required /></label>
            <label>Last name<input name="lastName" autocomplete="family-name" /></label>
          </div>
          <label>Email<input type="email" name="email" autocomplete="email" required /></label>
          <label>Message<textarea name="message" rows="6" required placeholder="Robot platform, ROS version, scope, timeline..."></textarea></label>
          <button class="button" type="submit">Send message</button>
          <p class="form-note" data-form-status>Send us your project details. We usually reply within one working day.</p>
        </form>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    const reveal = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          reveal.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12 });

    document.querySelectorAll('.reveal').forEach((element) => reveal.observe(element));

    const filterButtons = document.querySelectorAll('[data-filter]');
    const projectCards = document.querySelectorAll('[data-project]');
    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const filter = button.getAttribute('data-filter');
        filterButtons.forEach((item) => item.classList.remove('active'));
        button.classList.add('active');
        projectCards.forEach((card) => {
          const show = filter === 'all' || card.getAttribute('data-category') === filter;
          card.toggleAttribute('hidden', !show);
        });
      });
    });

    const form = document.querySelector('[data-contact-form]');
    const status = document.querySelector('[data-form-status]');
    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const endpoint = form.getAttribute('data-endpoint');

      if (!endpoint) {
        const name = `${data.get('firstName') || ''} ${data.get('lastName') || ''}`.trim();
        const subject = encodeURIComponent(`RUNTIME Robotics website enquiry from ${name || 'visitor'}`);
        const body = encodeURIComponent(`Name: ${name}\nEmail: ${data.get('email')}\n\n${data.get('message')}`);
        window.location.href = `mailto:runtimerobotics@gmail.com?subject=${subject}&body=${body}`;
        return;
      }

      try {
        status.textContent = 'Sending…';
        const response = await fetch(endpoint, {
          method: 'POST',
          body: data,
          headers: { Accept: 'application/json' }
        });
        if (!response.ok) throw new Error('Request failed');
        form.reset();
        status.textContent = 'Thanks — your message was sent.';
        window.gtag?.('event', 'generate_lead', { form: 'contact' });
      } catch {
        status.textContent = 'Could not send the form. Please email runtimerobotics@gmail.com.';
      }
    });
  </script>
</BaseLayout>
