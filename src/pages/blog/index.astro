---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { posts } from '../../data/posts';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Blog | RUNTIME Robotics" description="Articles about ROS, ROS 2, robot development, simulation and robotics engineering.">
  <Header />
  <main class="page-main" id="main">
    <section class="page-hero">
      <div class="container narrow">
        <span class="kicker">RUNTIME Robotics</span>
        <h1>Blog</h1>
        <p>Technical notes, project experience and lessons from building robot software with ROS.</p>
      </div>
    </section>
    <section class="section">
      <div class="container narrow">
        {posts.map((post) => (
          <a class="blog-feature visible" href={`${base}${post.slug}/`}>
            <div>
              <span class="blog-date">{post.displayDate}</span>
              <h2>{post.title}</h2>
              <p>{post.description}</p>
            </div>
            <span class="blog-arrow">↗</span>
          </a>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
