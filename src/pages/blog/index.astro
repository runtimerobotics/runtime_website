---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Blog | RUNTIME Robotics" description="Articles about ROS, ROS 2, robot development, simulation and robotics engineering.">
  <Header />
  <main class="page-main">
    <section class="page-hero">
      <div class="container narrow">
        <span class="kicker">RUNTIME Robotics</span>
        <h1>Blog</h1>
        <p>Technical notes, project experience and lessons from building robot software with ROS.</p>
      </div>
    </section>
    <section class="section">
      <div class="container narrow">
        <a class="blog-feature visible" href={`${base}physical-ai-the-future-of-robotics-software/`}>
          <div>
            <span class="blog-date">August 22, 2026</span>
            <h2>Physical AI, NVIDIA and ROS: The Future of Robotics Software</h2>
            <p>How ROS 2, NVIDIA Isaac, Omniverse simulation and robot learning are becoming one practical Physical AI workflow.</p>
          </div>
          <span class="blog-arrow">↗</span>
        </a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
