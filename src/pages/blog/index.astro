---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { posts, allTags, tagSlug } from '../../data/posts';
import PostCard from '../../components/PostCard.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Blog | RUNTIME Robotics" description="Articles about ROS, ROS 2, robot development, simulation and robotics engineering.">
  <Header />
  <main class="page-main" id="main">
    <section class="page-hero">
      <div class="container narrow">
        <span class="kicker">RUNTIME Robotics</span>
        <h1>Blog</h1>
        <p>Technical notes, project experience and lessons from building robot software with ROS.</p>
      </div>
    </section>
    <section class="section">
      <div class="container narrow">
        <nav class="topic-list" aria-label="Blog topics"><span>Topics</span>{allTags.map((tag) => <a href={`${base}blog/tag/${tagSlug(tag)}/`}>{tag}</a>)}</nav>
        {posts.map((post) => <PostCard post={post} heading="h2" />)}
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
