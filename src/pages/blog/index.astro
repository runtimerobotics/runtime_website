---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Blog | RUNTIME Robotics" description="Articles about ROS, ROS 2, robot development, simulation and robotics engineering.">
  <Header />
  <main class="page-main">
    <section class="page-hero">
      <div class="container narrow">
        <span class="kicker">RUNTIME Robotics</span>
        <h1>Blog</h1>
        <p>Technical notes, project experience and lessons from building robot software with ROS.</p>
      </div>
    </section>
    <section class="section">
      <div class="container narrow">
        <a class="blog-feature visible" href={`${base}10-years-of-ros-consulting-and-training-what-did-i-learn/`}>
          <div>
            <span class="blog-date">February 14, 2024</span>
            <h2>10 years of Remote ROS Development & Training: key lessons learned</h2>
            <p>A reflection on remote ROS development, consulting, training and the lessons learned along the way.</p>
          </div>
          <span class="blog-arrow">↗</span>
        </a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
