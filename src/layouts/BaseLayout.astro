---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  structuredData?: Record<string, unknown>;
}

const {
  title = 'RUNTIME Robotics | ROS Robot Software Development',
  description = 'ROS and ROS 2 robot software development, simulation, navigation, manipulation, perception, driver development and industrial training.',
  image = 'images/amr_robot.webp',
  structuredData
} = Astro.props;

const base = import.meta.env.BASE_URL;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
const socialImage = Astro.site ? new URL(`${base}${image}`, Astro.site) : `${base}${image}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#08111f" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}images/runtime_robotics_logo.webp`} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-X8ZMNHMG4H"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { window.dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'G-X8ZMNHMG4H');
    </script>

    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
