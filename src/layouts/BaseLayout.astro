---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'RUNTIME Robotics | ROS Robot Software Development',
  description = 'ROS and ROS 2 robot software development, simulation, navigation, manipulation, perception, driver development and industrial training.',
  image = 'images/amr_robot.webp'
} = Astro.props;

const base = import.meta.env.BASE_URL;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
const socialImage = Astro.site ? new URL(`${base}${image}`, Astro.site) : `${base}${image}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#08111f" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}images/runtime_robotics_logo.webp`} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
