---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PostCard from '../components/PostCard.astro';
import { posts, relatedPosts, tagSlug } from '../data/posts';
import { authors } from '../data/authors';
import { servicePages } from '../data/servicePages';

const { frontmatter, headings = [] } = Astro.props;
const sections = headings.filter((h: { depth: number }) => h.depth === 2);
const date = frontmatter.date ? new Date(frontmatter.date) : undefined;
const base = import.meta.env.BASE_URL;
const post = posts.find((p) => Astro.url.pathname.endsWith(`/${p.slug}/`));
const authorName: string = frontmatter.author ?? 'Lentin Joseph'; // same default as src/data/posts.ts
const author = authors[authorName];
const service = servicePages.find((s) => s.slug === frontmatter.service);
const related = post ? relatedPosts(post) : [];
const siteUrl = new URL(base, Astro.site).href;
const publisher = { '@type': 'Organization', name: 'RUNTIME Robotics', url: siteUrl, logo: { '@type': 'ImageObject', url: new URL(`${base}images/runtime_robotics_logo.webp`, Astro.site).href } };
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: frontmatter.title,
  description: frontmatter.description,
  url: new URL(Astro.url.pathname, Astro.site).href,
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
  ...(frontmatter.image && { image: new URL(`${base}${frontmatter.image}`, Astro.site).href }),
  ...(frontmatter.date && { datePublished: frontmatter.date }),
  author: { '@type': 'Person', name: authorName },
  publisher
};
---
<BaseLayout title={`${frontmatter.title} | RUNTIME Robotics`} description={frontmatter.description} image={frontmatter.image} structuredData={structuredData}>
  <Header />
  <main class="page-main" id="main">
    <article class="article container narrow">
      <header class="article-header">
        <span class="kicker">RUNTIME Robotics Blog</span>
        <h1>{frontmatter.title}</h1>
        <p class="post-meta">
          <span>By {authorName}{author && `, ${author.role}`}</span>
          {date && <time datetime={frontmatter.date}>{date.toLocaleDateString('en', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}</time>}
          {post && <span>{post.readingMinutes} min read</span>}
        </p>
        {post && post.tags.length > 0 && <ul class="tag-list">{post.tags.map((tag) => <li><a href={`${base}blog/tag/${tagSlug(tag)}/`}>{tag}</a></li>)}</ul>}
      </header>
      {sections.length >= 3 && (
        <nav class="toc" aria-label="In this article">
          <span class="kicker">In this article</span>
          <ol>{sections.map((h: { slug: string; text: string }) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </nav>
      )}
      <div class="article-body prose">
        <slot />
      </div>
      <div class="share-row">
        <span>Share this article</span>
        <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(new URL(Astro.url.pathname, Astro.site).href)}`} target="_blank" rel="noreferrer">LinkedIn ↗</a>
        <button type="button" data-copy-link={new URL(Astro.url.pathname, Astro.site).href}>Copy link</button>
      </div>
      {author && (
        <aside class="author-box" aria-label="About the author">
          <img src={`${base}${author.photo}`} alt={authorName} loading="lazy" />
          <div>
            <span class="kicker">About the author</span>
            <h2>{authorName}</h2>
            <p class="author-role">{author.role}</p>
            <p>{author.bio}</p>
            <a href={author.linkedin} target="_blank" rel="noreferrer">Connect on LinkedIn ↗</a>
          </div>
        </aside>
      )}
      <aside class="post-cta" aria-label="Work with RUNTIME Robotics">
        <span class="kicker">Work with us</span>
        <h2>{service ? service.heading : 'Need help with a robotics project?'}</h2>
        <p>{service ? service.description : 'Tell us about your robot, software stack and timeline.'}</p>
        <div class="post-cta-actions">
          {service && <a class="button" href={`${base}${service.slug}/`}>Explore {service.title}</a>}
          <a class:list={['button', service && 'button-ghost']} href={`${base}#contact`}>Discuss your project</a>
        </div>
      </aside>
      {related.length > 0 && (
        <section class="related-posts" aria-label="Related posts">
          <span class="kicker">Keep reading</span>
          <h2>You might also like</h2>
          {related.map((p) => <PostCard post={p} />)}
        </section>
      )}
    </article>
  </main>
  <script>
    document.querySelector('[data-copy-link]')?.addEventListener('click', async (event) => {
      const button = event.currentTarget as HTMLButtonElement;
      try {
        await navigator.clipboard.writeText(button.dataset.copyLink!);
        button.textContent = 'Link copied';
      } catch {
        button.textContent = 'Copy failed';
      }
      setTimeout(() => (button.textContent = 'Copy link'), 2000);
    });
  </script>
  <Footer />
</BaseLayout>
