---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const { frontmatter } = Astro.props;
const date = frontmatter.date ? new Date(frontmatter.date) : undefined;
---
<BaseLayout title={`${frontmatter.title} | RUNTIME Robotics`} description={frontmatter.description}>
  <Header />
  <main class="page-main">
    <article class="article container narrow">
      <header class="article-header">
        <span class="kicker">RUNTIME Robotics Blog</span>
        <h1>{frontmatter.title}</h1>
        {date && <p class="blog-date">{date.toLocaleDateString('en', { year: 'numeric', month: 'long', day: 'numeric' })}</p>}
      </header>
      <div class="article-body prose">
        <slot />
      </div>
    </article>
  </main>
  <Footer />
</BaseLayout>
